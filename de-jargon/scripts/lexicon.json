    { "pattern": "对齐", "level": "A", "family": "flow", "fix": "保持一致 / 同步为 / 确认一致" },

    { "pattern": "落地", "level": "A", "family": "buzz", "fix": "写明完成到哪一步：已实现 / 已部署 / 已通过验证" },
    { "pattern": "闭环", "level": "A", "family": "buzz", "fix": "写明闭环指什么：端到端能跑通 / 有回滚 / 有告警" },
    { "pattern": "沉淀", "level": "A", "family": "buzz", "fix": "记录为 / 汇总进 / 整理成" },
    { "pattern": "抓手", "level": "A", "family": "buzz", "fix": "具体做法 / 切入点" },
