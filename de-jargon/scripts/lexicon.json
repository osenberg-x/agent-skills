    { "pattern": "(三|四|五|六|七)道防线", "level": "A", "family": "pseudo", "fix": "逐条列出，不数个数" },
    { "pattern": "双保险", "level": "A", "family": "pseudo", "fix": "逐条列出两条措施" },
    { "pattern": "双链路", "level": "A", "family": "pseudo", "fix": "写明主备两条分别是什么" },

    { "pattern": "\\brobust(ness)?\\b", "level": "B", "family": "en", "fix": "stable / reliable，并写明在什么条件下", "only_in": ["prose", "comment"] },
    { "pattern": "\\bseamless(ly)?\\b", "level": "B", "family": "en", "fix": "无需改动调用方 / 对上层透明", "only_in": ["prose", "comment"] },
    { "pattern": "\\bleverag(e|es|ed|ing)\\b", "level": "B", "family": "en", "fix": "use / 借助", "only_in": ["prose", "comment"] },
    { "pattern": "\\bdelv(e|es|ed|ing)\\b", "level": "B", "family": "en", "fix": "look at / examine / 查看", "only_in": ["prose", "comment"] },
    { "pattern": "\\bcomprehensive(ly)?\\b", "level": "B", "family": "en", "fix": "写明覆盖哪些项，或写 full", "only_in": ["prose", "comment"] },
    { "pattern": "\\bholistic\\b", "level": "B", "family": "en", "fix": "整体 / 一并", "only_in": ["prose", "comment"] },
    { "pattern": "\\bactionable\\b", "level": "B", "family": "en", "fix": "可直接执行 / 具体到步骤", "only_in": ["prose", "comment"] },
    { "pattern": "\\bparadigm\\b", "level": "B", "family": "en", "fix": "model / approach", "only_in": ["prose", "comment"] },
    { "pattern": "\\b(crucial|pivotal)\\b", "level": "B", "family": "en", "fix": "写明为什么关键，或删掉", "only_in": ["prose", "comment"] },
    { "pattern": "\\bcutting[- ]edge\\b", "level": "B", "family": "en", "fix": "写明具体版本或特性", "only_in": ["prose", "comment"] },
    { "pattern": "\\bdeep dive\\b", "level": "B", "family": "en", "fix": "详细说明 / 展开讲", "only_in": ["prose", "comment"] },
    { "pattern": "it is worth noting|it's worth noting|in essence", "level": "B", "family": "en", "fix": "删掉，直接说", "only_in": ["prose", "comment"] }
  ],

  "identifier_patterns": [
    { "pattern": "\\bslot(s|_count)?\\b", "level": "B", "fix": "确认是否真是领域里的 slot；否则改成 index / entry / connection / position" },
    { "pattern": "\\bgate(s|d|_check)?\\b", "level": "B", "fix": "确认是否真是硬件或逻辑门；否则改成 auth / check / enabled" },
    { "pattern": "\\bthaw(ed|ing)?\\b", "level": "B", "fix": "resume / unfreeze / restore" },
    { "pattern": "\\bconverge(d|nce)?\\b", "level": "B", "fix": "settle / finalize / merge" },
    { "pattern": "\\bwatermark\\b", "level": "B", "fix": "仅流处理里有真义；否则改成 level / used / offset" },
    { "pattern": "\\bskeleton\\b", "level": "B", "fix": "仅 UI 骨架屏里有真义；否则改成 stub / template / outline" },
    { "pattern": "\\bclosure\\b", "level": "B", "fix": "闭包是真术语；业务语境下的 closure 改成 end_to_end / complete" }
  ],

  "yes_terms": [
