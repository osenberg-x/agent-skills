    { "pattern": "盘活", "level": "A", "family": "buzz", "fix": "启用 / 重新用起来" },
    { "pattern": "组合拳", "level": "A", "family": "buzz", "fix": "一组措施，逐条列出" },
    { "pattern": "打法", "level": "A", "family": "buzz", "fix": "做法" },
    { "pattern": "痒点", "level": "A", "family": "buzz", "fix": "次要需求" },
    { "pattern": "破局", "level": "A", "family": "buzz", "fix": "突破" },
    { "pattern": "降维", "level": "A", "family": "buzz", "fix": "化简 / 降为" },
    { "pattern": "深水区", "level": "A", "family": "buzz", "fix": "最难的部分" },
    { "pattern": "飞轮", "level": "B", "family": "buzz", "fix": "正向循环" },
    { "pattern": "势能", "level": "B", "family": "buzz", "fix": "潜力 / 储备" },
    { "pattern": "生态位", "level": "B", "family": "buzz", "fix": "定位" },
    { "pattern": "护城河", "level": "B", "family": "buzz", "fix": "优势" },
    { "pattern": "最后一公里", "level": "B", "family": "buzz", "fix": "收尾阶段的具体工作" },

    { "pattern": "兜底", "level": "B", "family": "fallback", "fix": "写明是哪一种：默认值 / 降级返回 / 失败后回滚 / 备用数据源" },
    { "pattern": "切片", "level": "B", "family": "slice", "fix": "分片 / 分批 / 按…拆分" },
    { "pattern": "链路", "level": "B", "family": "chain", "fix": "调用路径 / 数据流，并写明起点终点" },
