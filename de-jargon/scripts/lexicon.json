{
  "_note": "机器词表。pattern 按 Python re 语法；level A=默认改，B=看上下文；fix 是还原方向而非死替换。",
  "version": 2,

  "whitelist_patterns": [
    "(左|右|居中|两端|垂直|水平|居中对齐)对齐",
    "(文本|控件|图标|布局)对齐",
    "断点续传",
    "归一化",
    "水位线",
    "数字孪生",
    "垂直切片",
    "骨架屏",
    "锚点链接",
    "链路层",
    "数据链路",
    "灰度发布",
    "账号解冻|资金解冻|资产解冻"
  ],

  "entries": [
    { "pattern": "门禁", "level": "A", "family": "gate", "fix": "按实际机制写：鉴权 / 准入校验 / 功能开关判定" },
    { "pattern": "(发布|质量|准入|权限|安全|上线|合并|评审|构建|测试|归档)门(?!票|面|店|槛|户|禁|类)", "level": "A", "family": "gate", "fix": "写明检查什么：发布前跑回归 / 合并前过静态检查" },

    { "pattern": "解冻", "level": "A", "family": "state", "fix": "写明从哪个状态恢复：从 suspended 恢复调度 / 解除只读" },

    { "pattern": "槽位", "level": "A", "family": "spatial", "fix": "位置 / 空闲项 / 第 n 个条目" },
    { "pattern": "(缓存|任务|连接|线程|数据|消息|事件|对象|资源|句柄|会话|队列|请求|空闲|工作)槽", "level": "A", "family": "spatial", "fix": "指明是什么容器里的第几项，或直接说数组下标 / 连接" },
    { "pattern": "咬合", "level": "A", "family": "spatial", "fix": "对接 / 衔接，并写明两侧分别是什么" },
    { "pattern": "孪生(?!体)", "level": "A", "family": "spatial", "fix": "副本 / 两份需保持一致的数据，写明谁是源" },
    { "pattern": "锚点", "level": "B", "family": "spatial", "fix": "基准 / 参照点 / 固定位置" },
    { "pattern": "骨架", "level": "B", "family": "spatial", "fix": "结构 / 框架 / 待填充的部分" },
    { "pattern": "正交", "level": "B", "family": "spatial", "fix": "互不影响 / 可独立变更" },

    { "pattern": "收口", "level": "A", "family": "flow", "fix": "结束 / 完成 / 合并到主干" },
    { "pattern": "收窄", "level": "A", "family": "flow", "fix": "缩小到 / 仅限于" },
