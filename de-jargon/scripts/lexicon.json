    { "pattern": "收束", "level": "A", "family": "flow", "fix": "结尾 / 汇总" },
    { "pattern": "归一(?!化)", "level": "A", "family": "flow", "fix": "统一为同一种形式" },
    { "pattern": "拍平", "level": "A", "family": "flow", "fix": "展平 / 去掉嵌套层级" },
