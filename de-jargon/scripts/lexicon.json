    { "pattern": "体感", "level": "A", "family": "buzz", "fix": "实测 / 实际感受" },
    { "pattern": "心智", "level": "A", "family": "buzz", "fix": "理解 / 预期 / 认知" },
    { "pattern": "反哺", "level": "A", "family": "buzz", "fix": "反过来改进 / 回流到" },
